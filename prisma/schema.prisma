generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ArticleSource {
  BOT
  MANUAL
}

/**
 * Makalenin hangi şeritten geldiği. NEWS: RSS haber akışı, tazelik odaklı.
 * GUIDE: anahtar kelime havuzundan üretilen kalıcı rehber içerik.
 */
enum ContentTrack {
  NEWS
  GUIDE
}

enum AutonomyRisk {
  GREEN
  YELLOW
  RED
}

enum PublicationDecision {
  AUTO_PUBLISH
  REVIEW
  BLOCK
}

model Article {
  id                  String              @id @default(cuid())
  title               String
  slug                String              @unique
  meta                String
  keyword             String?
  category            String
  content             String
  imageUrl            String?
  source              String?
  status              ArticleStatus       @default(DRAFT)
  articleSource       ArticleSource       @default(BOT)
  premium             Boolean             @default(false)
  duplicateOf         String?
  seoScore            Int?
  // AI üretimi okuyucu yardımcıları: { summary: string[], impact: string, faq: {q,a}[] }.
  // Eski makalelerde null kalır; sayfa null'da kutuyu/FAQ schema'yı gizler (graceful).
  aiExtras            Json?
  riskLevel           AutonomyRisk        @default(YELLOW)
  publicationDecision PublicationDecision @default(REVIEW)
  sourceScore         Int?
  imageStrategy       String?
  automationMeta      Json?
  autoPublished       Boolean             @default(false)
  track               ContentTrack        @default(NEWS)
  keywordId           String?
  cluster             String?
  refreshedAt         DateTime?
  refreshCount        Int                 @default(0)
  publishedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([category, status])
  @@index([status, publishedAt(sort: Desc)])
  @@index([publicationDecision, createdAt(sort: Desc)])
  @@index([track, status])
  @@index([cluster, status])
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model SiteSettings {
  id    String @id @default("singleton")
  value Json   @default("{}")
}

model BreakingNews {
  id        String    @id @default(cuid())
  text      String
  url       String?
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model Subscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  active      Boolean   @default(true)
  // Hangi kategorilere abone (kripto/borsa/doviz/altin/ekonomi). Boş = tümü.
  preferences String[]  @default([])
  // Abonenin geldiği kaynak (ör. "site-form", "popup", "import")
  source      String?
  // Çift-onay (double opt-in): doğrulanana kadar bülten gönderilmez.
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([active, confirmed])
}

// A/B konu satırı testli bülten gönderimleri + açılma oranı takibi
model NewsletterCampaign {
  id          String   @id @default(cuid())
  segment     String? // null = tüm aktif aboneler, aksi halde kategori
  subjectA    String
  subjectB    String? // null ise A/B testi yok
  recipients  Int      @default(0)
  recipientsA Int      @default(0)
  recipientsB Int      @default(0)
  opensA      Int      @default(0)
  opensB      Int      @default(0)
  sentAt      DateTime @default(now())

  @@index([sentAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([path, createdAt])
}

model BotRun {
  id                String    @id @default(cuid())
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  articlesFound     Int       @default(0)
  articlesAdded     Int       @default(0)
  duplicatesSkipped Int       @default(0)
  autoPublished     Int       @default(0)
  reviewQueued      Int       @default(0)
  blocked           Int       @default(0)
  imageFallbacks    Int       @default(0)
  errors            String?
  status            String    @default("running")
}

model AutomationEvent {
  id        String   @id @default(cuid())
  runId     String?
  articleId String?
  stage     String
  level     String   @default("info")
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
  @@index([articleId, createdAt])
}

enum KeywordStatus {
  QUEUED
  IN_PROGRESS
  PUBLISHED
  FAILED
  PAUSED
}

enum KeywordIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
}

/**
 * Şerit B'nin (rehber içerik) konu kaynağı. RSS'ten değil arama talebinden
 * beslenir. `cluster` alanı hub/spoke iç linklemesini sürer: aynı kümedeki
 * makaleler birbirine ve kümenin hub sayfasına bağlanır.
 */
model Keyword {
  id          String        @id @default(cuid())
  term        String        @unique
  category    String
  cluster     String
  isHub       Boolean       @default(false)
  intent      KeywordIntent @default(INFORMATIONAL)
  priority    Int           @default(50)
  status      KeywordStatus @default(QUEUED)
  // Havuza nasıl girdi: "seed" (elle/başlangıç), "gsc" (Search Console'dan
  // keşfedildi), "expansion" (mevcut kelimeden türetildi).
  origin      String        @default("seed")
  notes       String?
  articleId   String?
  lastTriedAt DateTime?
  attempts    Int           @default(0)
  lastError   String?
  // En son senkronda ölçülen Search Console değerleri; kimlik bilgisi yoksa null kalır.
  impressions Int?
  clicks      Int?
  position    Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, priority(sort: Desc)])
  @@index([cluster])
  @@index([category, status])
}

/**
 * Sayfa/sorgu bazlı arama performansının günlük anlık görüntüsü. Kaynak
 * Search Console; kimlik bilgisi yokken `source: "internal"` ile kendi
 * PageView verimizden doldurulur, böylece tazeleme döngüsü her hâlükârda çalışır.
 */
model SearchPerformance {
  id          String   @id @default(cuid())
  date        DateTime
  page        String
  query       String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  source      String   @default("gsc")
  createdAt   DateTime @default(now())

  @@unique([date, page, query])
  @@index([page, date(sort: Desc)])
  @@index([date(sort: Desc), impressions(sort: Desc)])
}
