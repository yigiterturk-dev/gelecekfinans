# gelecekfinans-site — ortam değişkenleri örneği
# Gerçek değerler ASLA bu dosyaya yazılmaz. Netcup üretim sırları
# /opt/gelecekfinans/.env.production içinde, 600 izinleriyle tutulur.
# Lokal geliştirme için bu dosyayı .env.local olarak kopyalayıp doldur.

# --- Veritabanı (zorunlu) ---
DATABASE_URL="postgresql://user:pass@127.0.0.1:5434/gelecekfinans" # Netcup PostgreSQL

# --- Auth (zorunlu) ---
NEXTAUTH_SECRET="openssl rand -base64 32 ile üret"
NEXTAUTH_URL="https://gelecekfinans.com"                        # lokalde http://localhost:3000

# --- Makale üretim sağlayıcısı ---
# GelecekFinans üretimde OpenAI kullanır. Claude yalnız açıkça seçilirse yedektir.
ARTICLE_AI_PROVIDER="openai"               # openai | anthropic
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_ARTICLE_MODEL="claude-sonnet-5"
ANTHROPIC_VERIFIER_MODEL="claude-haiku-4-5"
# Opsiyonel: bireysel hesaplarda sunulmayabilir. Standart API key'den farklıdır;
# yalnızca admin panelindeki kurumsal aylık maliyet raporu için kullanılır.
ANTHROPIC_ADMIN_KEY="sk-ant-admin01-..."

# OpenAI anahtarı eklenmeden üretim görevleri kuyruğa dokunmadan durur.
OPENAI_API_KEY="sk-..."
OPENAI_ARTICLE_MODEL="gpt-5"
OPENAI_VERIFIER_MODEL="gpt-5-mini"
ARTICLE_DAILY_WRITER_CALL_LIMIT="24"       # İstanbul gününde sert üst sınır
ARTICLE_MAX_WRITER_CALLS_PER_RUN="6"
OPENAI_WRITER_MAX_OUTPUT_TOKENS="5000"
OPENAI_VERIFIER_MAX_OUTPUT_TOKENS="800"
ARTICLE_EVIDENCE_PROMPT_MAX_CHARS="14000"
ARTICLE_EVIDENCE_ITEM_MAX_CHARS="2500"

# --- Cron & bot tetikleme sırları (zorunlu) ---
CRON_SECRET="rastgele uzun string"        # systemd görevleri bunu Bearer olarak gönderir
BOT_SECRET="rastgele uzun string"         # admin panelinden elle bot tetikleme
NEWSLETTER_SECRET="rastgele uzun string"  # newsletter işlemleri

# --- E-posta (newsletter — zorunlu) ---
RESEND_API_KEY="re_..."
MAIL_FROM="GelecekFinans <bulten@gelecekfinans.com>"

# --- Site & medya ---
SITE_URL="https://gelecekfinans.com"
UNSPLASH_ACCESS_KEY=""                        # opsiyonel — makale görseli fallback
# Üretilen/yüklenen görseller sunucudaki public/gorseller dizinine yazılır.

# --- Ayarlar (opsiyonel) ---
BREAKING_NEWS_TTL_HOURS="24"                  # son dakika banner ömrü (saat)

# GA4 ve Search Console doğrulama etiketi admin panelinden yönetilir.
# Search Console performans API'si için ayrıca salt okunur servis hesabı gerekir.
GSC_CLIENT_EMAIL=""
GSC_PRIVATE_KEY=""
GSC_SITE_URL="sc-domain:gelecekfinans.com"
